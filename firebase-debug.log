[debug] [2026-10-14T09:10:13.192Z] >>> [apiv2][body] PUT http://127.0.0.1:8081/emulator/v1/projects/demo-trips:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\n// Trips are private to their members.\n//   • Anyone signed in with Google can create a trip; they become its owner.\n//   • Only members (owner + collaborators, by Google email) can read or edit it.\n//   • Only the owner can change the member list or delete the trip.\n//   • A collaborator can remove themselves (\"leave trip\").\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function signedIn() {\n      return request.auth != null\n        && request.auth.token.firebase.sign_in_provider == 'google.com'\n        && request.auth.token.email is string;\n    }\n    function myEmail() { return request.auth.token.email.lower(); }\n    function isMember(data) { return signedIn() && myEmail() in data.memberEmails; }\n    function isOwner(data) { return signedIn() && request.auth.uid == data.ownerUid; }\n\n    function validTrip(d) {\n      return d.keys().hasOnly(['title', 'subtitle', 'timezone', 'days', 'ownerUid', 'ownerEmail',\n                               'memberEmails', 'createdAt', 'updatedAt', 'updatedBy'])\n        && d.title is string && d.title.size() > 0 && d.title.size() <= 120\n        && d.subtitle is string && d.subtitle.size() <= 300\n        && d.timezone is string && d.timezone.size() <= 64\n        && d.days is list && d.days.size() <= 60\n        && d.memberEmails is list && d.memberEmails.size() >= 1 && d.memberEmails.size() <= 20\n        && d.ownerEmail in d.memberEmails\n        && d.updatedBy == myEmail()\n        && d.updatedAt == request.time;\n    }\n\n    match /trips/{tripId} {\n      allow read: if isMember(resource.data);\n\n      allow create: if signedIn()\n        && validTrip(request.resource.data)\n        && request.resource.data.ownerUid == request.auth.uid\n        && request.resource.data.ownerEmail == myEmail()\n        && request.resource.data.memberEmails == [myEmail()]\n        && request.resource.data.createdAt == request.time;\n\n      // Members edit the plan; only the owner may change who the members are.\n      allow update: if isMember(resource.data)\n        && validTrip(request.resource.data)\n        && request.resource.data.ownerUid == resource.data.ownerUid\n        && request.resource.data.ownerEmail == resource.data.ownerEmail\n        && request.resource.data.createdAt == resource.data.createdAt\n        && (request.resource.data.memberEmails == resource.data.memberEmails\n            || isOwner(resource.data)\n            || leaving());\n\n      allow delete: if isOwner(resource.data);\n\n      // Shared progress (done / skipped stops). Any member can tick or untick a stop.\n      match /state/{docId} {\n        function trip() { return get(/databases/$(database)/documents/trips/$(tripId)).data; }\n        allow read: if isMember(trip());\n        allow create, update: if docId == 'progress'\n          && isMember(trip())\n          && request.resource.data.keys().hasOnly(['done', 'updatedBy', 'updatedAt'])\n          && request.resource.data.done is map\n          && request.resource.data.done.size() <= 1000\n          && request.resource.data.updatedBy == myEmail()\n          && request.resource.data.updatedAt == request.time;\n        allow delete: if isOwner(trip());\n      }\n    }\n\n    // A collaborator removing only themselves, touching nothing else.\n    function leaving() {\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberEmails', 'updatedAt', 'updatedBy'])\n        && !isOwner(resource.data)\n        && request.resource.data.memberEmails.toSet() == resource.data.memberEmails.toSet().difference([myEmail()].toSet());\n    }\n  }\n}\n"}]}}
