{
  "name": "gowander",
  "private": true,
  "type": "module",
  "description": "Plan trips together and follow them live. React + TypeScript (Vite) + Firebase (Google sign-in, Firestore).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --port 8090",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "emulators": "firebase emulators:start --project demo-trips --only auth,firestore",
    "test:rules": "firebase emulators:exec --project demo-trips --only firestore \"node --test tests/*.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "firebase": "10.14.1",
    "leaflet": "1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/leaflet": "1.9.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "firebase-tools": "^13.35.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
